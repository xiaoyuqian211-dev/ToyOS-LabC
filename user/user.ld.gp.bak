OUTPUT_ARCH(riscv)
ENTRY(_start)

PHDRS
{
  text PT_LOAD FLAGS(5);
  data PT_LOAD FLAGS(6);
}

SECTIONS
{
  . = 0x0;

  .text : ALIGN(0x1000)
  {
    *(.text.entry)
    *(.text)
    *(.text.*)
  } :text

  .rodata : ALIGN(16)
  {
    *(.srodata)
    *(.srodata.*)
    *(.rodata)
    *(.rodata.*)
  } :text

  .data : ALIGN(0x1000)
  {
    *(.sdata)
    *(.sdata.*)
    *(.data)
    *(.data.*)
  } :data

  .bss : ALIGN(16)
  {
    *(.sbss)
    *(.sbss.*)
    *(.bss)
    *(.bss.*)
    *(COMMON)
  } :data

  . = ALIGN(0x1000);
  PROVIDE(end = .);
}
